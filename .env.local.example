# Set to "false" to call the real scanner backend instead of the mock data layer.
NEXT_PUBLIC_USE_MOCKS=true

# Only used when NEXT_PUBLIC_USE_MOCKS=false.
NEXT_PUBLIC_API_BASE_URL=https://backend.bizcatchup.com

# Firebase web config for the "biz-scan" project (production). Only used when
# NEXT_PUBLIC_USE_MOCKS=false — real login needs a real ID token. This is the
# same web config already shipped publicly in the Flutter app
# (biz-scan-flutter/bizcatchup_flutter/lib/firebase_options.dart) — a Firebase
# web apiKey is a project identifier, not a secret, so it's safe to keep here.
# Sign in with an @trackier.com or @bizcatchup.com Firebase Auth
# (Email/Password) user — the backend rejects anything else.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCex0rEhFSXog0s1-XWnQuicW2ywUFjO_w
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=biz-scan.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=biz-scan
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=biz-scan.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=437652059152
NEXT_PUBLIC_FIREBASE_APP_ID=1:437652059152:web:644cb0573e943144ae0695
